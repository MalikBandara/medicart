{
  "name": "medicart",
  "version": "1.0.0",
  "description": "Medicart medical center management workspace",
  "main": "server/index.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.cjs\" \"vite --host 127.0.0.1\"",
